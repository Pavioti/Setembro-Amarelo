            display: block;
            font-size: 1.2rem;
            margin-bottom: 8px;
        }


        /* =========================
           IMAGENS
        ========================= */

        .imagens {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 25px;
        }

        .imagens img {
            width: 100%;
            height: 300px;
            object-fit: cover;
            border: 2px solid #e3c000;
        }

        .banner-apoio {
            min-height: 270px;
            margin: 30px 0;
            padding: 30px;
