        }


        /* =========================
           RODAPÉ
        ========================= */

        footer {
            background: #222;
            color: #ddd;
            text-align: center;
            padding: 30px 20px;
            margin-top: 50px;
        }

        footer strong {
            color: #ffd900;
        }


        /* =========================
           RESPONSIVIDADE
        ========================= */

        @media (max-width: 800px) {

            header h1 {
                font-size: 2.1rem;
            }

            .banner-apoio {
                min-height: 260px;
                padding: 28px;
