        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #fffdf2;
            color: #292929;
            line-height: 1.6;
        }

        a {
            text-decoration: none;
            color: inherit;
        }


        /* =========================
           CABEÇALHO
        ========================= */

        header {
            min-height: 290px;
            padding: 55px 20px;
            text-align: center;
            color: #222;
            background: linear-gradient(135deg, #ffd900, #ffed75);
        }

        header h1 {
            font-size: 2.6rem;
