</head>


<body>

    <!-- CABEÇALHO -->

    <header id="inicio">

        <h1>Setembro Amarelo</h1>

        <p>
            Valorização da vida, acolhimento e cuidado com a saúde mental.
        </p>

    </header>


    <!-- MENU -->

    <nav>

        <button type="button" data-aba="sobre" aria-controls="sobre" aria-pressed="true">Início</button>
